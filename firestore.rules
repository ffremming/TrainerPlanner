rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasActiveStatus(userData) {
      return !('status' in userData) || userData.status == 'active';
    }

    function isActiveUser() {
      return userExists() && hasActiveStatus(getUserData());
    }

    function isValidStatus(status) {
      return status == 'active' || status == 'pending' || status == 'disabled';
    }

    function hasRole(role) {
      return isActiveUser() && (
        getUserData().role == role ||
        ('roles' in getUserData() && role in getUserData().roles)
      );
    }

    function isSuperadmin() {
      return hasRole('superadmin');
    }

    function isCoachOf(athleteId) {
      return isActiveUser()
        && exists(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + athleteId));
    }

    function canAccessAthlete(athleteId) {
      return isActiveUser() && (
        athleteId == request.auth.uid ||
        isSuperadmin() ||
        isCoachOf(athleteId)
      );
    }

    function isTemplateOwner(templateData) {
      return isActiveUser() && templateData.ownerId == request.auth.uid;
    }

    function isBuiltinTemplate(templateData) {
      return templateData.source == 'builtin';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidSelfCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'workoutLayout',
          'role', 'roles', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.workoutLayout in ['list', 'calendar']
        && request.resource.data.role == 'athlete'
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[0] == 'athlete'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // A visitor arriving through a valid share link self-creates as an ACTIVE
    // athlete (the invite is their authorization), stamped with the token so we
    // can confirm the invite exists. No superadmin activation needed.
    function isValidInvitedSelfCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.role == 'athlete'
        && request.resource.data.roles == ['athlete']
        && request.resource.data.status == 'active'
        && request.resource.data.invitedVia is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.invitedVia));
    }

    function isValidUserAdminUpdate() {
      return !changedKeys().hasAny(['uid', 'email', 'createdAt'])
        && (!('status' in request.resource.data) || isValidStatus(request.resource.data.status))
        && (!('roles' in request.resource.data) || request.resource.data.roles is list);
    }

    function isSafeProfileUpdate() {
      return changedKeys().hasOnly([
        'displayName', 'workoutLayout', 'maxHr', 'thresholdHr', 'vo2maxHr',
        'easyTempo', 'longTempo', 'results', 'updatedAt'
      ]);
    }

    // A draft athlete is a placeholder "plan for someone else" — no real person
    // signs in behind it. Any active user may create one they own, so plans can
    // be authored without coaching a real athlete first.
    function isValidDraftCreate(userId) {
      return isActiveUser()
        && request.resource.data.uid == userId
        && request.resource.data.isDraft == true
        && request.resource.data.ownerCoachId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.roles == ['athlete'];
    }

    function isDraftUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.isDraft == true;
    }

    // Active users may add the additive 'coach' role to their OWN profile
    // (authoring or claiming a shared plan promotes them to coach).
    function isSelfCoachPromotion() {
      return changedKeys().hasOnly(['role', 'roles', 'updatedAt'])
        && request.resource.data.roles is list
        && 'athlete' in request.resource.data.roles;
    }

    // Users collection
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isSuperadmin() ||
        (hasRole('coach') && isCoachOf(userId)) ||
        // Athletes browse the coach directory to pick their own coaches.
        (isActiveUser() && 'coach' in resource.data.roles)
      );
      // New users self-create as pending athletes (superadmin then activates);
      // invited users self-create as active via a valid share link; or an active
      // user creates a draft "plan" athlete that they own.
      allow create: if isValidSelfCreate(userId)
        || isValidInvitedSelfCreate(userId)
        || isValidDraftCreate(userId);
      // Self/coach profile edits cannot change identity, roles, or status —
      // except a user adding the additive 'coach' role to their own profile.
      // Superadmins can manage role and status but not rewrite immutable identity.
      allow update: if isActiveUser() && (
        (isSuperadmin() && isValidUserAdminUpdate()) ||
        (request.auth.uid == userId && isSafeProfileUpdate()) ||
        (request.auth.uid == userId && isSelfCoachPromotion()) ||
        (isCoachOf(userId) && isSafeProfileUpdate())
      );
    }

    // Coach-Athlete Relationships
    match /relationships/{relationshipId} {
      allow read: if isActiveUser() && (
        isSuperadmin() ||
        resource.data.coachId == request.auth.uid ||
        resource.data.athleteId == request.auth.uid
      );
      // Superadmins manage any link; athletes manage links where they are the
      // athlete; and a user may make themselves coach of a draft "plan" athlete
      // (authoring or claiming a shared plan).
      allow create, update: if isActiveUser()
        && (
          isSuperadmin() ||
          request.auth.uid == request.resource.data.athleteId ||
          (request.auth.uid == request.resource.data.coachId && isDraftUser(request.resource.data.athleteId))
        )
        && request.resource.data.coachId is string
        && request.resource.data.athleteId is string
        && relationshipId == request.resource.data.coachId + '_' + request.resource.data.athleteId;
      allow delete: if isActiveUser()
        && (isSuperadmin() || resource.data.athleteId == request.auth.uid);
    }

    // Share-by-link plan invites. The inviter (a coach of the draft) creates the
    // token; any active user may read it to claim, and may stamp themselves as
    // the claimer. The token itself is the unguessable secret.
    match /invites/{token} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.token == token
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.athleteId is string
        && isCoachOf(request.resource.data.athleteId);
      // Claiming may only stamp claimedBy/claimedAt with the caller's identity.
      allow update: if isActiveUser()
        && changedKeys().hasOnly(['claimedBy', 'claimedAt'])
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.athleteId == resource.data.athleteId
        && request.resource.data.inviterId == resource.data.inviterId;
    }

    // Workouts
    match /workouts/{workoutId} {
      allow read: if canAccessAthlete(resource.data.athleteId);
      allow create: if isActiveUser()
        && request.resource.data.athleteId is string
        && canAccessAthlete(request.resource.data.athleteId);
      allow update: if canAccessAthlete(resource.data.athleteId)
        && request.resource.data.athleteId == resource.data.athleteId;
      allow delete: if canAccessAthlete(resource.data.athleteId);
    }

    // Per-athlete plan annotations (focus bands, post-it notes, competitions).
    // The document id IS the athlete's uid, so access is gated on that id —
    // same shape as stravaConnections. Coaches/superadmins of the athlete and
    // the athlete themselves may read and write; the stored athleteId must match
    // the document id.
    match /plans/{athleteId} {
      allow read: if canAccessAthlete(athleteId);
      allow create, update: if canAccessAthlete(athleteId)
        && request.resource.data.athleteId == athleteId;
      allow delete: if canAccessAthlete(athleteId);
    }

    // Templates (global, read by all authenticated, write by superadmin/coach)
    match /templates/{templateId} {
      allow read: if isActiveUser() && (
        isBuiltinTemplate(resource.data) ||
        isTemplateOwner(resource.data) ||
        isSuperadmin()
      );
      allow create: if isActiveUser() && (
        isSuperadmin() ||
        (
          hasRole('coach') &&
          request.resource.data.source == 'custom' &&
          isTemplateOwner(request.resource.data)
        )
      );
      allow update: if isActiveUser() && (
        isSuperadmin() ||
        (
          hasRole('coach') &&
          !isBuiltinTemplate(resource.data) &&
          isTemplateOwner(resource.data)
        )
      )
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.source == resource.data.source;
      allow delete: if isActiveUser() && (
        isSuperadmin() ||
        (
          hasRole('coach') &&
          !isBuiltinTemplate(resource.data) &&
          isTemplateOwner(resource.data)
        )
      );
    }

    // Global session library (read by all authenticated, write by superadmin only)
    match /globalTemplates/{templateId} {
      allow read: if isActiveUser();
      allow write: if isSuperadmin();
    }

    // Per-athlete session pool (coach maintains a session bank per athlete)
    match /athleteSessions/{sessionId} {
      allow read: if isActiveUser() && (
        isSuperadmin() ||
        resource.data.coachId == request.auth.uid ||
        resource.data.athleteId == request.auth.uid ||
        isCoachOf(resource.data.athleteId)
      );
      allow create: if isActiveUser() && (
        isSuperadmin() ||
        (
          request.resource.data.coachId == request.auth.uid &&
          isCoachOf(request.resource.data.athleteId)
        )
      );
      allow update: if isActiveUser() && (
        isSuperadmin() ||
        (
          resource.data.coachId == request.auth.uid &&
          isCoachOf(resource.data.athleteId)
        )
      )
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data.athleteId == resource.data.athleteId;
      allow delete: if isActiveUser() && (
        isSuperadmin() ||
        (
          resource.data.coachId == request.auth.uid &&
          isCoachOf(resource.data.athleteId)
        )
      );
    }

    // Tests
    match /tests/{testId} {
      allow read: if canAccessAthlete(resource.data.athleteId);
      allow create: if isActiveUser()
        && request.resource.data.athleteId is string
        && canAccessAthlete(request.resource.data.athleteId);
      allow update: if canAccessAthlete(resource.data.athleteId)
        && request.resource.data.athleteId == resource.data.athleteId;
      allow delete: if canAccessAthlete(resource.data.athleteId);
    }

    match /completedActivities/{activityId} {
      // Imported and written only by Cloud Functions (Admin SDK bypasses rules).
      allow read: if canAccessAthlete(resource.data.athleteId);
      allow write: if false;
    }

    match /stravaConnections/{athleteId} {
      // Token storage. Read by owner/coach; never client-writable.
      allow read: if canAccessAthlete(athleteId);
      allow write: if false;
    }
  }
}
